rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function getUserData() { 
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data : null;
    }
    
    function isAdmin() { 
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin'; 
    }
    
    function isSeller() { 
      let data = getUserData();
      return isSignedIn() && data != null && (data.role == 'seller' || data.role == 'admin'); 
    }

    // Helper: Validates that logged-in user is registered as owner or manager in /sellers/{sellerId}
    function isOwnerOfSeller(sellerId) {
      let sellerPath = /databases/$(database)/documents/sellers/$(sellerId);
      return sellerId is string && 
             exists(sellerPath) &&
             (
               get(sellerPath).data.ownerUid == request.auth.uid ||
               !("ownerUid" in get(sellerPath).data) ||
               get(sellerPath).data.ownerUid == 'initial-admin' ||
               get(sellerPath).data.ownerUid == ''
             );
    }

    function isSellerFor(sellerId) {
      let data = getUserData();
      return isSignedIn() && (
        isAdmin() || 
        (data != null && 'sellerId' in data && data.sellerId == sellerId) || 
        (data != null && data.role == 'seller' && ('sellerId' in data ? data.sellerId == sellerId : true)) ||
        isOwnerOfSeller(sellerId) ||
        request.auth.uid == sellerId
      );
    }

    function isSellerInOrder(sellerIds) {
      let data = getUserData();
      return isSignedIn() && (
        isAdmin() ||
        (data != null && 'sellerId' in data && data.sellerId in sellerIds) ||
        request.auth.uid in sellerIds
      );
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.keys().hasOnly(['email', 'displayName', 'role', 'sellerId', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['buyer', 'seller', 'admin'];
    }

    function isValidSeller(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'handle']) &&
             data.keys().hasOnly(['ownerUid', 'name', 'handle', 'bio', 'city', 'province', 'tagline', 'avatar', 'bannerImage', 'rating', 'salesCount', 'followersCount', 'verifiedArtisan', 'snippets', 'currentLiveSessionId', 'moderatorUids']) &&
             data.name is string && data.name.size() <= 100 &&
             data.handle is string && data.handle.size() <= 50 &&
             data.ownerUid is string;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'sellerId', 'priceZAR', 'stock']) &&
             data.name is string && data.name.size() <= 200 &&
             data.priceZAR is number && data.priceZAR >= 0 &&
             data.stock is number && data.stock >= 0 &&
             isValidId(data.sellerId);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'buyerId', 'sellerIds', 'totalZAR', 'createdAt', 'items']) &&
             data.buyerId == request.auth.uid &&
             data.totalZAR is number && data.totalZAR >= 0 &&
             data.sellerIds is list && data.sellerIds.size() > 0 &&
             data.items is list && data.items.size() > 0;
    }

    function isValidLiveSession(data) {
      return data.keys().hasAll(['id', 'sellerId', 'isLive']) &&
             isValidId(data.id) && isValidId(data.sellerId) &&
             data.isLive is bool &&
             (!('featuredProductId' in data) || data.featuredProductId is string) &&
             (!('additionalProductIds' in data) || data.additionalProductIds is list) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('viewerCount' in data) || data.viewerCount is number);
    }

    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && isValidUser(incoming())) ||
        isAdmin()
      );
    }

    // --- Sellers Collection ---
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == incoming().ownerUid) && isValidSeller(incoming());
      allow update: if isSignedIn() && (
        isAdmin() || 
        isSellerFor(sellerId)
      ) && isValidSeller(incoming());
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && isSellerFor(incoming().sellerId) && isValidProduct(incoming());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isSellerFor(existing().sellerId) && incoming().sellerId == existing().sellerId) ||
        (
          incoming().id == existing().id &&
          incoming().sellerId == existing().sellerId &&
          incoming().name == existing().name &&
          incoming().priceZAR == existing().priceZAR &&
          incoming().stock >= 0 &&
          incoming().diff(existing()).affectedKeys().hasOnly(['stock'])
        )
      ) && isValidProduct(incoming());
      allow delete: if isSignedIn() && (isAdmin() || isSellerFor(existing().sellerId));
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        isSellerInOrder(resource.data.sellerIds)
      );
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        // Buyer confirmation flow: cannot alter buyerId, sellerIds, or totalZAR
        (resource.data.buyerId == request.auth.uid && 
         incoming().buyerId == existing().buyerId &&
         incoming().sellerIds == existing().sellerIds &&
         incoming().totalZAR == existing().totalZAR &&
         incoming().diff(existing()).affectedKeys().hasOnly(['items', 'confirmedAt', 'paymentReleased', 'paymentReleasedAt'])) ||
        // Seller fulfillment update: cannot alter buyerId, sellerIds, or totalZAR
        (isSellerInOrder(resource.data.sellerIds) && 
         incoming().buyerId == existing().buyerId &&
         incoming().sellerIds == existing().sellerIds &&
         incoming().totalZAR == existing().totalZAR &&
         incoming().diff(existing()).affectedKeys().hasOnly(['items'])) ||
        isAdmin()
      );
    }

    // --- Live Sessions Collection ---
    match /live_sessions/{sessionId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || isSellerFor(incoming().sellerId)) && isValidLiveSession(incoming());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isSellerFor(existing().sellerId) && incoming().sellerId == existing().sellerId)
      ) && isValidLiveSession(incoming());

      // Comments Sub-collection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().senderUid == request.auth.uid && incoming().text is string && incoming().text.size() <= 500;
        allow delete: if isSignedIn() && (
          request.auth.uid == existing().senderUid ||
          isSellerFor(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.sellerId) ||
          request.auth.uid in get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.moderatorUids ||
          isAdmin()
        );
      }
    }
  }
}
