rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function getUserData() { 
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data : null;
    }
    
    function isAdmin() { 
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin'; 
    }
    
    function isSeller() { 
      let data = getUserData();
      return isSignedIn() && data != null && (data.role == 'seller' || data.role == 'admin'); 
    }

    // Helper: Validates that logged-in user is registered as owner in /sellers/{sellerId}
    function isOwnerOfSeller(sellerId) {
      return sellerId is string && 
             exists(/databases/$(database)/documents/sellers/$(sellerId)) &&
             get(/databases/$(database)/documents/sellers/$(sellerId)).data.ownerUid == request.auth.uid;
    }

    function isSellerFor(sellerId) {
      let data = getUserData();
      return isSignedIn() && (
        isAdmin() || 
        (data != null && 'sellerId' in data && data.sellerId == sellerId) || 
        isOwnerOfSeller(sellerId)
      );
    }

    function isSellerInOrder(sellerIds) {
      let data = getUserData();
      return isSignedIn() && (
        isAdmin() ||
        (data != null && 'sellerId' in data && data.sellerId in sellerIds) ||
        (sellerIds.size() > 0 && isOwnerOfSeller(sellerIds[0]))
      );
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'role', 'sellerId', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['buyer', 'seller', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidSeller(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'handle']) &&
             data.keys().hasOnly(['ownerUid', 'name', 'handle', 'bio', 'city', 'province', 'tagline', 'avatar', 'bannerImage', 'rating', 'moderatorUids']) &&
             data.name is string && data.name.size() <= 100 &&
             data.handle is string && data.handle.size() <= 50 &&
             data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin());
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'sellerId', 'priceZAR', 'stock']) &&
             data.name is string && data.name.size() <= 200 &&
             data.priceZAR is number && data.priceZAR >= 0 &&
             data.stock is number && data.stock >= 0 &&
             isValidId(data.sellerId);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'buyerId', 'sellerIds', 'totalZAR', 'createdAt', 'items']) &&
             data.buyerId == request.auth.uid &&
             data.totalZAR is number && data.totalZAR >= 0 &&
             data.sellerIds is list && data.sellerIds.size() > 0 &&
             data.items is list && data.items.size() > 0;
    }

    function isValidLiveSession(data) {
      return data.keys().hasAll(['id', 'sellerId', 'isLive']) &&
             isValidId(data.id) && isValidId(data.sellerId) &&
             data.isLive is bool;
    }

    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().role == 'buyer';
      // Regular user can ONLY update displayName (cannot change role or sellerId). Admin can update role & sellerId.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && 
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName']) &&
         incoming().role == existing().role) ||
        isAdmin()
      );
    }

    // --- Sellers Collection ---
    match /sellers {
      allow list: if true;
      match /{sellerId} {
        allow get: if true;
        allow create: if isAdmin() && isValidSeller(incoming());
        allow update: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin()) 
                      && incoming().ownerUid == existing().ownerUid && isValidSeller(incoming());
      }
    }

    // --- Products Collection ---
    match /products {
      allow list: if true;

      match /{productId} {
        allow get: if true;
        allow create: if isSignedIn() && isSellerFor(incoming().sellerId) && isValidProduct(incoming());
        allow update: if isSignedIn() && (
          isAdmin() || 
          (isSellerFor(existing().sellerId) && incoming().sellerId == existing().sellerId)
        ) && isValidProduct(incoming());
        allow delete: if isSignedIn() && (isAdmin() || isSellerFor(existing().sellerId));
      }
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        isSellerInOrder(resource.data.sellerIds)
      );
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        // Buyer confirmation flow: cannot alter buyerId, sellerIds, or totalZAR
        (resource.data.buyerId == request.auth.uid && 
         incoming().buyerId == existing().buyerId &&
         incoming().sellerIds == existing().sellerIds &&
         incoming().totalZAR == existing().totalZAR &&
         incoming().diff(existing()).affectedKeys().hasOnly(['items', 'confirmedAt', 'paymentReleased', 'paymentReleasedAt'])) ||
        // Seller fulfillment update: cannot alter buyerId, sellerIds, or totalZAR
        (isSellerInOrder(resource.data.sellerIds) && 
         incoming().buyerId == existing().buyerId &&
         incoming().sellerIds == existing().sellerIds &&
         incoming().totalZAR == existing().totalZAR &&
         incoming().diff(existing()).affectedKeys().hasOnly(['items'])) ||
        isAdmin()
      );
    }

    // --- Live Sessions Collection ---
    match /live_sessions {
      allow list: if true;

      match /{sessionId} {
        allow get: if true;
        allow create: if isSignedIn() && (isAdmin() || isSellerFor(incoming().sellerId)) && isValidLiveSession(incoming());
        allow update: if isSignedIn() && (
          isAdmin() || 
          (isSellerFor(existing().sellerId) && incoming().sellerId == existing().sellerId)
        ) && isValidLiveSession(incoming());

        // Comments Sub-collection
        match /comments/{commentId} {
          allow read: if true;
          allow create: if isSignedIn() && incoming().senderUid == request.auth.uid && incoming().text is string && incoming().text.size() <= 500;
          allow delete: if isSignedIn() && (
            request.auth.uid == existing().senderUid ||
            isSellerFor(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.sellerId) ||
            request.auth.uid in get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.moderatorUids ||
            isAdmin()
          );
        }
      }
    }
  }
}
